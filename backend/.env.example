PORT=5000
NODE_ENV=development

# Database (MongoDB)
# Local Docker or local Mongo
MONGODB_URI=mongodb://localhost:27017/ashashop
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ashashop?retryWrites=true&w=majority

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Or Redis Cloud URL:
# REDIS_URL=rediss://default:password@host:port

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_ashashop_2026_dev_mode
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_ashashop_2026
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
