# ==============================================================================
# AshaShop Backend - Environment Configuration (.env.example)
# ==============================================================================

# Application Server
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Database (MongoDB)
# ------------------------------------------------------------------------------
# Local Docker or local Mongo instance:
MONGODB_URI=mongodb://localhost:27017/ashashop
# Or MongoDB Atlas Cluster:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ashashop?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Cache & Session Store (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. JWT Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_ashashop_2026_dev_mode
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_ashashop_2026
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. CORS Origins (Comma-separated)
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://asha-shop.vercel.app

# ------------------------------------------------------------------------------
# 5. OAuth2 Single Sign-On (Google & Facebook)
# ------------------------------------------------------------------------------
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ------------------------------------------------------------------------------
# 6. SMTP Email Service (Gửi email xác thực, OTP, hóa đơn)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AshaShop Fashion <contact@tuancute.com>

# ------------------------------------------------------------------------------
# 7. VNPAY Payment Gateway (Sandbox / Production)
# ------------------------------------------------------------------------------
# Đăng ký Sandbox tại: https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE=2QXUI4J4
VNPAY_HASH_SECRET=AQURBLHQDFMSMYVTLHCVGNYFJWVTLGVC
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

# ------------------------------------------------------------------------------
# 8. MoMo All-in-One Payment Gateway (Sandbox / Production)
# ------------------------------------------------------------------------------
# Đăng ký Sandbox tại: https://developers.momo.vn/
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1wa8ngT4df13TJ0Bi0i9p3TM
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/payment/momo-return
MOMO_IPN_URL=http://localhost:5000/api/v1/payments/momo-ipn

# ------------------------------------------------------------------------------
# 9. PayPal REST API Gateway (Sandbox / Production)
# ------------------------------------------------------------------------------
# Đăng ký Developer App tại: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:3000/payment/paypal-return
