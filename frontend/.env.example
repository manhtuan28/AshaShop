# ==============================================================================
# AshaShop Frontend - Environment Configuration (.env.example)
# ==============================================================================

# Backend REST API Endpoint (Local Docker / Dev Server / VPS)
# Ví dụ: http://localhost:5000/api/v1 hoặc https://aov.maitiendung.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Google OAuth2 Authentication (Google Cloud Console Client ID)
# Lấy tại: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Facebook Login Authentication (Meta for Developers App ID)
# Lấy tại: https://developers.facebook.com/apps/
VITE_FACEBOOK_APP_ID=
