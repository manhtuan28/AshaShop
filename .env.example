# Cấu hình chung AshaShop

# Backend Port & Host
PORT=5000
NODE_ENV=development

# MongoDB (Local Docker hoặc MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/ashashop
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ashashop?retryWrites=true&w=majority

# Redis Cache (Local hoặc Redis Cloud)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_ashashop_2026_dev_mode
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_ashashop_2026
JWT_REFRESH_EXPIRES_IN=7d

# Frontend API URL
VITE_API_URL=http://localhost:5000/api/v1
